# IGORS - Information de Gestion des Opérations de Routage et de Suivi
# Laboratoire Externe CNTS Côte d'Ivoire

# Application settings
APP_NAME=IGORS
APP_VERSION=2.0.0
ENVIRONMENT=development

# Database (PostgreSQL 15+)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=igors_db
DATABASE_USER=igors_user
DATABASE_PASSWORD=changeme_in_production

# Security
SECRET_KEY=your-secret-key-change-in-production
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=30

# OTP Settings
OTP_ISSUER=IGORS_CNTS
OTP_DIGITS=6
OTP_INTERVAL=30

# Encryption (AES-256)
ENCRYPTION_KEY=change-this-to-32-bytes-key!!!

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
JWT_EXPIRY_HOURS=8

# File paths
DATA_DIR=./data
LOGS_DIR=./logs
BACKUPS_DIR=./backups
RESOURCES_DIR=./resources

# SMTP (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SNIS Transmission
SNIS_API_URL=https://snis.ci/api
SNIS_API_KEY=
